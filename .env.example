# ===== Django =====
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== 数据库（默认 MySQL）=====
# 若本机没有 MySQL，可临时改为 sqlite 快速体验：
#   DB_ENGINE=sqlite
DB_ENGINE=mysql
DB_NAME=testflow
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== DeepSeek API =====
# 必填：前往 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2

# ===== Embedding（向量化）=====
# hash：内置的字符 n-gram 哈希向量，离线可用（默认）
# sentence_transformers：真实语义模型，需额外安装 sentence-transformers
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=256

# ===== Milvus 向量库（可选）=====
# 开启后需先用 docker compose up 启动 Milvus
MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=testcase_vectors

# 相似用例检索返回条数
SIMILAR_TOP_K=5
